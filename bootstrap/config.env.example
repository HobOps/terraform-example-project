# Copy to bootstrap/config.env and edit it. bootstrap/bootstrap.sh and
# `make init` (scripts/init) both read it.
#
# Commit config.env in your project: it holds no secrets and it is the single
# source of truth for the project, bucket and KMS names.

# GCP project that holds the state bucket, the KMS key and, in this example,
# the resources. 6-30 characters: lowercase letters, digits and hyphens.
PROJECT_ID="my-project-tf-1234"

# Parent of the project when bootstrap has to create it: set ORG_ID or
# FOLDER_ID (numeric IDs), or neither for a project without an organization.
# Ignored when the project already exists.
ORG_ID=""
FOLDER_ID=""

# Billing account to link, e.g. 0X0X0X-0X0X0X-0X0X0X
# (`gcloud billing accounts list`). Ignored when billing is already enabled.
BILLING_ACCOUNT=""

# Default region for the resources.
REGION="us-central1"

# Terraform state bucket. Bucket names are global, so keep the project ID in it.
STATE_BUCKET="${PROJECT_ID}-tfstate"
STATE_BUCKET_LOCATION="US"
# Versions of each state file to keep, including the current one. Older
# versions are your restore points (docs/operations.md).
STATE_VERSIONS_TO_KEEP=10

# Cloud KMS key that SOPS uses to encrypt the CSEK and the other secrets.
KMS_LOCATION="global"
KMS_KEYRING="sops"
KMS_KEY="sops-key"

# APIs to enable besides Cloud Storage and Cloud KMS, space separated.
# The example stacks need Secret Manager.
EXTRA_APIS="secretmanager.googleapis.com"

# Who else runs Terraform, space separated, e.g.
# "group:devops@example.com user:alice@example.com". They get access to the
# KMS key and the state bucket. Whoever runs bootstrap.sh does not need to be
# listed.
TERRAFORM_MEMBERS=""
